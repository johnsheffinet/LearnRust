@httpUrl = http://127.0.0.1:3080
@httpsUrl = https://127.0.0.1:3443

### ---------------------------------------------------------
### HTTP
### GET /
### Expected: 404 Not Found
### ---------------------------------------------------------

GET {{httpUrl}}/

### ---------------------------------------------------------
### HTTP
### GET /healthz
### Expected: 307 Temporary Redirect
### ---------------------------------------------------------

# @no-redirect
GET {{httpUrl}}/healthz

### ---------------------------------------------------------
### HTTPS
### GET /healthz
### Expected: 200 OK
### ---------------------------------------------------------

GET {{httpsUrl}}/healthz

### ---------------------------------------------------------
### HTTPS
### POST /items
### Expected: 201 Created
### ---------------------------------------------------------

# @name createItem
POST {{httpsUrl}}/items
Content-Type: application/json

{
  "name": "integration-test",
  "desc": "created by REST Client"
}

### ---------------------------------------------------------
### Save the ID returned by POST /items
### ---------------------------------------------------------

@itemId = {{createItem.response.body.$.id}}

### ---------------------------------------------------------
### HTTPS
### GET /items
### Expected: 200 OK
### ---------------------------------------------------------

GET {{httpsUrl}}/items

### ---------------------------------------------------------
### HTTPS
### GET /items?name=integration-test
### Expected: 200 OK
### ---------------------------------------------------------

GET {{httpsUrl}}/items?name=integration-test

### ---------------------------------------------------------
### HTTPS
### GET /items/{id}
### Expected: 200 OK
### ---------------------------------------------------------

GET {{httpsUrl}}/items/{{itemId}}

### ---------------------------------------------------------
### HTTPS
### PUT /items/{id}
### Expected: 200 OK
### ---------------------------------------------------------

PUT {{httpsUrl}}/items/{{itemId}}
Content-Type: application/json

{
  "name": "integration-test-updated",
  "desc": "updated by REST Client"
}

### ---------------------------------------------------------
### HTTPS
### GET /items/{id}
### Verify update
### Expected: 200 OK
### ---------------------------------------------------------

GET {{httpsUrl}}/items/{{itemId}}

### ---------------------------------------------------------
### HTTPS
### DELETE /items/{id}
### Expected: 200 OK
### ---------------------------------------------------------

DELETE {{httpsUrl}}/items/{{itemId}}

### ---------------------------------------------------------
### HTTPS
### GET /items
### Verify delete
### Expected: 200 OK
### The deleted item should no longer appear.
### ---------------------------------------------------------

GET {{httpsUrl}}/items